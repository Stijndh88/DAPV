# Copy to .env on the server (chmod 600). Never commit the real .env.

# --- Site ---
SITE_DOMAIN=plasvissers.be
SITE_URL=https://plasvissers.be
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=webmaster@plasvissers.be

# --- App image (built by GitHub Actions) ---
APP_IMAGE=ghcr.io/stijndh88/dapv
APP_TAG=latest

# --- Secrets: generate each with `openssl rand -hex 32` ---
POSTGRES_USER=plasvissers
POSTGRES_DB=plasvissers
POSTGRES_PASSWORD=change-me
PAYLOAD_SECRET=change-me

# --- Outgoing mail for the CMS (password resets, invitations). Optional. ---
# Use a transactional provider (Brevo, Mailjet, Postmark) or your mailbox's SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plasvissers <noreply@plasvissers.be>"

# --- Backups ---
BACKUP_CRON=30 3 * * *
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Offsite copy, e.g. a Hetzner Storage Box configured in ./rclone/rclone.conf
# BACKUP_RCLONE_REMOTE=storagebox:plasvissers
BACKUP_RCLONE_REMOTE=
# Optional dead-man's switch (e.g. https://hc-ping.com/<uuid>): alerts you if backups stop.
BACKUP_HEALTHCHECK_URL=
