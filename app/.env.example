# PostgreSQL connection string
DATABASE_URI=postgres://payload:payload@localhost:5432/plasvissers
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=https://plasvissers.be
# Where uploaded media is stored (container default: /app/media)
# MEDIA_DIR=/app/media
# Optional: SMTP for password-reset mails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=website@plasvissers.be
